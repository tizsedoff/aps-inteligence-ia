# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# GEMINI_IMAGE_MODEL: (Opcional) Modelo para generar imágenes.
# Por defecto usa "gemini-2.5-flash-image", que tiene capa gratuita en la API de Gemini.
# Revisa los límites vigentes en https://ai.google.dev/gemini-api/docs/pricing
GEMINI_IMAGE_MODEL=""

# ── Proveedores adicionales (opcionales) ──
# Revisión cruzada del código generado por la consola (APS HARD WORK).
# Un proveedor queda activo solo si tiene clave Y modelo configurados. Los IDs de modelo
# no vienen por defecto: usá los que figuren en la documentación de cada proveedor.
GROQ_API_KEY=""
GROQ_REVIEW_MODEL=""
NVIDIA_API_KEY=""
NVIDIA_REVIEW_MODEL=""
# Orden de preferencia para revisar (por defecto: groq,nvidia)
REVIEW_PROVIDERS="groq,nvidia"

# ── Cobros con Mercado Pago (apagados mientras falte alguna de estas variables) ──
# Solo se cargan en Vercel (Settings → Environment Variables), nunca en el código ni en chats.
MP_ACCESS_TOKEN=""            # Access Token de tu aplicación en Mercado Pago Developers
MP_WEBHOOK_SECRET=""          # "Clave secreta" del webhook, en la misma aplicación
SUPABASE_SERVICE_ROLE_KEY=""  # Clave de servicio de Supabase: da acceso total, solo en el servidor
MP_USD_ARS_RATE=""            # Pesos por dólar con que se cobran los planes (ej. 1500). Actualizar a mano
APS_APP_URL="https://aps-inteligence.vercel.app"  # A dónde vuelve el usuario después de pagar
# URL del webhook a registrar en Mercado Pago: https://aps-inteligence.vercel.app/api/billing/webhook
# Evento a activar: "Planes y suscripciones" (subscription_preapproval)
