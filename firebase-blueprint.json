{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile with configuration, memories and privileges",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Unique user ID" },
        "name": { "type": "string", "description": "Display name" },
        "email": { "type": "string", "description": "Email address" },
        "avatar": { "type": "string", "description": "Base64 or image URL" },
        "membership": { "type": "string", "description": "Membership tier" },
        "isAdmin": { "type": "boolean", "description": "Admin status" },
        "customInstructions": { "type": "string", "description": "User instructions for AI" },
        "memories": { "type": "array", "description": "AI memory items" },
        "createdAt": { "type": "number", "description": "Creation timestamp" }
      },
      "required": ["id", "email"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "User profile and memory documents"
    }
  }
}
